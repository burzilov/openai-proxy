[Unit]
Description=openai-proxy FreeLLMAPI normalize gateway
After=network-online.target freellmapi.service
Wants=network-online.target freellmapi.service

[Service]
Type=simple
# Binary only — no source tree required on the host.
ExecStart=/usr/local/bin/openai-proxy gateway
Environment=GATEWAY_LISTEN=:3002
Environment=GATEWAY_UPSTREAM=http://127.0.0.1:3001
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
